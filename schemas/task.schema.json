{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/task.schema.json",
  "title": "SDD 任务定义",
  "type": "object",
  "required": ["id", "title", "phase", "status"],
  "properties": {
    "id": { "type": "string", "pattern": "^TASK-[0-9]{3}-[A-Z]+$" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "phase": {
      "type": "string",
      "enum": ["RED", "GREEN", "REFACTOR", "VERIFY"]
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "BUILDING", "DONE", "FAILED", "SKIPPED"]
    },
    "acceptance": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowedFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expectedNewFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbiddenFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command"],
        "properties": {
          "command": { "type": "string" },
          "args": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
