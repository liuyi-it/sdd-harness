{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/task.schema.json",
  "title": "SDD 任务定义",
  "type": "object",
  "required": [
    "id", "title", "phase", "requirements", "scenarios", "dependsOn",
    "allowedFiles", "expectedNewFiles", "forbiddenFiles", "verification", "doneCriteria",
    "sliceType", "userVisibleOutcome", "acceptanceCriteria", "testSeam"
  ],
  "$defs": {
    "phase": {
      "type": "string",
      "enum": ["RED", "GREEN", "REFACTOR", "VERIFY"]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-\\d{3}-(RED|GREEN|REFACTOR|VERIFY)$"
    },
    "title": { "type": "string", "minLength": 1 },
    "phase": { "$ref": "#/$defs/phase" },
    "allowedFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "expectedNewFiles": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "forbiddenFiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependsOn": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^TASK-\\d{3}-(RED|GREEN|REFACTOR|VERIFY)$" }
    },
    "doneCriteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "sliceType": {
      "type": "string",
      "enum": ["VERTICAL", "EXPAND", "MIGRATE", "CONTRACT"]
    },
    "userVisibleOutcome": { "type": "string", "minLength": 1 },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "testSeam": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
