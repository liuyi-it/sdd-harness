{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/task.schema.json",
  "title": "SDD 任务定义",
  "type": "object",
  "required": ["id", "title", "phase", "status"],
  "$defs": {
    "phase": {
      "type": "string",
      "enum": ["RED", "GREEN", "REFACTOR", "VERIFY"]
    },
    "status": {
      "type": "string",
      "enum": ["PENDING", "BUILDING", "DONE", "FAILED", "SKIPPED"]
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^TASK-\\d{3}-(RED|GREEN|REFACTOR|VERIFY)$"
    },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "phase": { "$ref": "#/$defs/phase" },
    "status": { "$ref": "#/$defs/status" },
    "acceptance": {
      "type": "array",
      "items": { "type": "string" }
    },
    "allowedFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "expectedNewFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "forbiddenFiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification": {
      "type": "array",
      "items": { "type": "string" }
    },
    "requirements": {
      "type": "array",
      "items": { "type": "string" }
    },
    "scenarios": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependsOn": {
      "type": "array",
      "items": { "type": "string" }
    },
    "doneCriteria": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "additionalProperties": true
}
