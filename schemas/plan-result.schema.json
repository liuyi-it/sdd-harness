{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "summary", "globalConstraints", "dependencies", "tasks"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "3.0.0" },
    "summary": { "type": "string", "minLength": 1 },
    "globalConstraints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "manifest", "action", "reason", "requirements"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "manifest": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "enum": ["ADD", "UPDATE", "REMOVE"] },
          "reason": { "type": "string", "minLength": 1 },
          "requirements": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^REQ-[0-9]{3}$" } }
        },
        "additionalProperties": false
      }
    },
    "tasks": { "type": "array", "minItems": 1, "items": { "$ref": "task.schema.json" } }
  },
  "additionalProperties": false
}
