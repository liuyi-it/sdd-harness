{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "title", "given", "when", "then"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]{3}-SC-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "given": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "when": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "then": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["id", "title", "statement", "scenarios"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["requirements"],
      "properties": {
        "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } }
      },
      "additionalProperties": false
    },
    "scope": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "excluded": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schemaVersion", "goal", "scope", "constraints", "model"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "4.0.0" },
    "goal": { "type": "string", "minLength": 1 },
    "scope": { "$ref": "#/$defs/scope" },
    "constraints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "model": { "$ref": "#/$defs/model" }
  },
  "additionalProperties": false
}
