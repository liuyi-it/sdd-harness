{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "state", "config", "artifacts", "changes", "runs", "workflows", "index"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [7] },
    "state": { "type": "object" },
    "config": { "type": "object" },
    "artifacts": {
      "type": "object",
      "required": ["schemaVersion", "artifacts"],
      "properties": {
        "schemaVersion": { "type": "string", "enum": ["2.0.0"] },
        "artifacts": { "type": "object" }
      },
      "additionalProperties": false
    },
    "changes": { "type": "object" },
    "runs": { "type": "object" },
    "workflows": { "type": "object" },
    "index": { "type": "object" }
  },
  "additionalProperties": false
}
