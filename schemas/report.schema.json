{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/report.schema.json",
  "title": "SDD 质量报告",
  "type": "object",
  "required": ["kind", "summary", "passed", "changeId", "issues"],
  "properties": {
    "kind": {
      "type": "string",
      "const": "quality"
    },
    "summary": { "type": "string" },
    "passed": { "type": "boolean" },
    "changeId": { "type": "string", "minLength": 1 },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "message": { "type": "string" },
          "file": { "type": "string" },
          "category": { "type": "string" },
          "startLine": { "type": "integer", "minimum": 1 },
          "endLine": { "type": "integer", "minimum": 1 },
          "existingCode": { "type": "string" },
          "suggestionCode": { "type": "string" },
          "origin": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "minimality": { "type": "object" }
  },
  "additionalProperties": false
}
