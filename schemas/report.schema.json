{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/report.schema.json",
  "title": "SDD 验证/审查报告",
  "type": "object",
  "required": ["kind", "summary", "passed"],
  "properties": {
    "kind": {
      "type": "string",
      "enum": ["verify", "review"]
    },
    "summary": { "type": "string" },
    "passed": { "type": "boolean" },
    "changeId": { "type": ["string", "null"] },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string" },
          "severity": {
            "type": "string",
            "enum": ["critical", "high", "medium", "low"]
          },
          "message": { "type": "string" },
          "file": { "type": ["string", "null"] },
          "category": { "type": ["string", "null"] },
          "startLine": { "type": ["integer", "null"], "minimum": 0 },
          "endLine": { "type": ["integer", "null"], "minimum": 0 },
          "existingCode": { "type": ["string", "null"] },
          "suggestionCode": { "type": ["string", "null"] },
          "origin": { "type": ["string", "null"] }
        }
      }
    }
  },
  "additionalProperties": true
}
