{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sdd-harness.dev/schemas/state.schema.json",
  "title": "SDD 项目状态",
  "type": "object",
  "required": [
    "schemaVersion", "version", "updatedAt", "initialized", "currentPhase",
    "indexStatus", "codebaseProvider", "degraded", "degradedReason", "lastCommand"
  ],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [4] },
    "version": { "type": "integer", "minimum": 1 },
    "updatedAt": { "type": "string", "minLength": 1 },
    "initialized": { "type": "boolean" },
    "currentPhase": {
      "type": "string",
      "enum": ["NOT_INITIALIZED", "INITIALIZING", "INDEX_READY"]
    },
    "indexStatus": {
      "type": "string",
      "enum": ["MISSING", "INDEX_READY", "UNAVAILABLE"]
    },
    "codebaseProvider": {
      "type": "string",
      "enum": ["codegraph", "fallback-file-scan"]
    },
    "degraded": { "type": "boolean" },
    "degradedReason": { "type": ["string", "null"] },
    "lastCommand": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
