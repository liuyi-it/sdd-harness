{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "title", "given", "when", "then"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]{3}-SC-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "given": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "when": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "then": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["id", "title", "statement", "scenarios"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "scenarios": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/scenario" } }
      },
      "additionalProperties": false
    },
    "decision": {
      "type": "object",
      "required": ["title", "decision", "rationale"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "decision": { "type": "string", "minLength": 1 },
        "rationale": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "technicalDesign": {
      "type": "object",
      "required": [
        "summary", "currentState", "decisions", "affectedFiles", "interfaces",
        "dataChanges", "errorHandling", "testStrategy", "risks", "rollback"
      ],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "currentState": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "decisions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } },
        "affectedFiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "interfaces": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "dataChanges": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "errorHandling": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "testStrategy": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "risks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "rollback": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": ["schemaVersion", "status", "requirement", "goal", "scope", "constraints", "model"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "5.0.0" },
    "status": { "type": "string", "const": "READY" },
    "requirement": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "object",
      "required": ["included", "excluded"],
      "properties": {
        "included": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "excluded": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "additionalProperties": false
    },
    "constraints": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "model": {
      "type": "object",
      "required": ["requirements", "technicalDesign"],
      "properties": {
        "requirements": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/requirement" } },
        "technicalDesign": { "$ref": "#/$defs/technicalDesign" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
