{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scenario": {
      "type": "object",
      "required": ["id", "title", "given", "when", "then"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]{3}-SC-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "given": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "when": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "then": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["id", "title", "statement", "scenarios"],
      "properties": {
        "id": { "type": "string", "pattern": "^REQ-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "scenarios": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/scenario" }
        }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["requirements"],
      "properties": {
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/requirement" }
        }
      },
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "required": ["id", "round", "title", "severity", "question", "recommendation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "round": { "type": "integer", "minimum": 1 },
        "title": { "type": "string", "minLength": 1 },
        "severity": { "type": "string", "const": "BLOCKER" },
        "question": { "type": "string", "minLength": 1 },
        "recommendation": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "required": ["schemaVersion", "status", "requirement", "questions"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "3.0.0" },
        "status": { "type": "string", "const": "CLARIFYING" },
        "requirement": { "type": "string", "minLength": 1 },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/question" }
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["schemaVersion", "status", "requirement", "impact", "answers", "model"],
      "properties": {
        "schemaVersion": { "type": "string", "const": "3.0.0" },
        "status": { "type": "string", "const": "READY" },
        "requirement": { "type": "string", "minLength": 1 },
        "impact": { "type": "string", "minLength": 1 },
        "answers": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "model": { "$ref": "#/$defs/model" }
      },
      "additionalProperties": false
    }
  ]
}
